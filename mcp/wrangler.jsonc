{
  // Cloudflare Worker for the MCP server. It is separate from the site (GitHub Pages) and
  // only reads the site's public feed. Cloudflare Workers Builds deploys it from `main` with
  // root directory `mcp` (see README.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seattle-grocery-deals-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Its own address: mcp.seattlegrocery.deals. The domain's DNS stays at Porkbun, so the
  // hostname is a Cloudflare "custom hostname" on the kylepace.dev zone (a CNAME at Porkbun
  // points mcp at fallback.kylepace.dev) and this route sends its traffic here. See README.md.
  "routes": [{ "pattern": "mcp.seattlegrocery.deals/*", "zone_name": "kylepace.dev" }],
  "preview_urls": false,
  "observability": { "enabled": true },
  // "Think this is wrong?" reports (src/reports.js): per store, a count and two times, kept a
  // week. The flyer watcher reads them.
  "kv_namespaces": [{ "binding": "REPORTS", "id": "44d2574c33fe4a639ef0ad94db34a1c4" }],
  "vars": {
    // The same feed the iPhone app reads.
    "FEED_URL": "https://seattlegrocery.deals/api/week.json",
    // The hosts the MCP handler answers on (it refuses any other): the real address, the
    // workers.dev one it started on, and localhost for `npm run dev`.
    "ALLOWED_HOSTNAMES": "mcp.seattlegrocery.deals,seattle-grocery-deals-mcp.mail-4dd.workers.dev,localhost,127.0.0.1"
  }
}
